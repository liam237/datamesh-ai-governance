# Modèle de configuration : copier ce fichier en .env, puis adapter les valeurs.
#   cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore). Les valeurs ci-dessous
# servent uniquement au développement local : à changer avant tout autre usage.

# --- Reproductibilité -----------------------------------------------------
# Graine aléatoire commune à la génération des données et aux modèles.
RANDOM_SEED=42

# --- Base de données PostgreSQL (étape 8) ---------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datamesh_gov
POSTGRES_USER=datamesh
POSTGRES_PASSWORD=change-me

# --- Stockage objet compatible S3 : Garage ou MinIO (étape 8) -------------
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=datamesh-gov
S3_SECURE=false

# --- Catalogue OpenMetadata, optionnel (étape 8) -------------------------
OPENMETADATA_URL=http://localhost:8585/api
OPENMETADATA_TOKEN=

# --- Modèle de langage local, mécanisme 7 (étape 7) ----------------------
# N'importe quel serveur local compatible avec l'API OpenAI, qui sert un
# modèle Mistral ouvert. Laissé vide : le mécanisme 7 bascule sur un gabarit.
LLM_BASE_URL=
LLM_MODEL=mistral
